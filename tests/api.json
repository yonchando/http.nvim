    "event": [
        {
            "listen": "prerequest",
            "script": {
                "exec": [
                    "const xsrfToken = pm.environment.get('xsrf_token');\r",
                    "\r",
                    "pm.request.headers.upsert({\r",
                    "    key: \"Accept\",\r",
                    "    value: \"application/json\"\r",
                    "})\r",
                    "\r",
                    "if (xsrfToken) {\r",
                    "    pm.request.headers.upsert({\r",
                    "        key: 'X-XSRF-TOKEN',\r",
                    "        value: xsrfToken\r",
                    "    });\r",
                    "}"
                ],
                "type": "text/javascript"
            }
        },
        {
            "listen": "test",
            "script": {
                "exec": [
                    "var xsrfToken = pm.cookies.get(\"XSRF-TOKEN\");\r",
                    "\r",
                    "if (xsrfToken) {\r",
                    "    pm.environment.set(\"xsrf_token\", decodeURIComponent(xsrfToken));\r",
                    "}"
                ],
                "type": "text/javascript"
            }
        }
